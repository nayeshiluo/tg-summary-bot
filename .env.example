# ===== 必填 =====
# BotFather 拿到的 Token
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_TOKEN
# 你的 Telegram 数字 ID（给 @userinfobot 发消息可查）
OWNER_ID=123456789

# ===== 群授权 =====
# 可选：初始授权群，逗号分隔，例如 -1001234567890,-1009876543210
# 也可以启动后由 Owner 在群里发 /auth 授权
AUTHORIZED_GROUPS=

# ===== 运行参数（可选）=====
DATA_DIR=./data
# 消息保留天数，0 表示永久保留
MESSAGE_RETENTION_DAYS=30
# 普通群员的取数上限
MEMBER_MAX_MESSAGES=500
MEMBER_MAX_HOURS=24
# Owner / 群管理员的取数上限
PRIVILEGED_MAX_MESSAGES=3000
PRIVILEGED_MAX_HOURS=168
# 少于多少条消息不生成总结
MIN_MESSAGES=3
# 默认 /sum 条数
DEFAULT_MESSAGE_LIMIT=80

# ===== LLM 密钥 =====
# 供 data/llm_endpoints.json 里的 key_env 引用；有几个供应商就配几个
LLM_API_KEY=sk-replace-me
# LLM_BACKUP_API_KEY=sk-replace-me-too
